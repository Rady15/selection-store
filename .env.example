# ============ Server ============
# Port the Express server listens on
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Public URL of the site (used for OAuth callbacks / self-referential links)
APP_URL=http://localhost:3000

# ============ Data Store ============
# Path to the flat-file JSON database (relative to project root)
DATA_FILE=data-store.json

# ============ Admin Credentials ============
# Initial admin account (force-migrated on every boot)
ADMIN_EMAIL=admin@selection.sa
ADMIN_PASSWORD=admin123

# ============ Auth ============
# Secret used to sign auth tokens / sessions (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth Client ID — backend token verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client ID — frontend (Vite exposes only VITE_-prefixed vars).
# If using Next.js instead, expose it as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Authorized JavaScript Origins in Google Cloud Console → Credentials → OAuth 2.0 Client IDs:
#   - http://localhost:3000
#   - http://127.0.0.1:3000
#   - https://<your-production-domain>
# (These are configured in Google Cloud Console, NOT in this file.)

# ============ Shipping (SMSA) ============
# SMSA Express API credentials — required only when switching from the mock to the live API
SMSA_API_KEY=your-smsa-api-key
SMSA_PASSKEY=your-smsa-passkey

# ============ Google AI ============
# Gemini API key (AI Studio injects this at runtime from user secrets)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ============ Stripe Payments ============
# Stripe secret key (sk_test_... for testing / sk_live_... for production).
# Get it at https://dashboard.stripe.com/apikeys
# When empty, the server runs in "sandbox" mode: checkout shows a simulated
# "إتمام الدفع (محاكاة)" button and no real charge is attempted.
STRIPE_SECRET_KEY=

# Stripe publishable key (pk_test_... / pk_live_...). Exposed to the browser,
# so it must be a VITE_-prefixed variable. Same dashboard as above.
VITE_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...). Get it by running:
#   stripe listen --forward-to localhost:3000/api/payments/webhook
# then copy the whsec_... value it prints.
STRIPE_WEBHOOK_SECRET=

# ============ Vercel ============
# Set automatically by Vercel (VERCEL=1). When present, the server:
#   - stores data in /tmp/data-store.json (ephemeral, resets per cold start)
#   - runs as a serverless function (api/index.ts) instead of listening on a port
