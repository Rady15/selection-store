# Production environment — copy to .env on the server and fill every secret.
NODE_ENV=production
PORT=3000

# Security (required)
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@your-domain.tld
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Database (required in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/selection

# Frontend / CORS
APP_URL=https://your-domain.tld
CORS_ORIGIN=https://your-domain.tld

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Stripe (required when online payments are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# SMSA (enable only after replacing the mock adapter with live credentials)
SMSA_API_URL=
SMSA_API_KEY=
SMSA_ACCOUNT=
SMSA_PASSWORD=

# Local development only
# DATA_FILE=data-store.json
# ALLOW_SANDBOX_PAYMENTS=true
